+/**
+ * A caller whose JWT `permissions` claim grants ALL_PERMISSIONS is a
+ * SUPERADMIN (see identity-admin-service's role seed: role SUPERADMIN ->
+ * permission ALL_PERMISSIONS). authentication.js's authorize() already uses
+ * this same check to bypass the per-route permission gate; we reuse it here
