PORT=3100
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_organization
DB_USER=organization_service
DB_PASSWORD=replace_me

# Organization-service does NOT own users/roles/permissions — those live in
# identity-service's own database (see the "no cross-DB FKs" note in
# database/complete_db_script). Authorization here is claims-based: it trusts
# the permissions/roles embedded in the JWT that identity-service issued,
# rather than re-querying identity's tables on every request. Configure
# exactly one verifier below — ADMIN_JWKS_URL is recommended for production
# and should point at identity-service's /.well-known/jwks.json.
ADMIN_JWKS_URL=http://localhost:3000/.well-known/jwks.json
ADMIN_JWT_ISSUER=https://idp.example.com/
ADMIN_JWT_AUDIENCE=sp3-identity-admin

# ADMIN_JWT_SECRET=development_only_shared_secret

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset for local dev only (falls back to permissive CORS) — every
# real environment (staging/prod) MUST set this explicitly.
# ALLOWED_ORIGINS=https://admin.sp3digital.com,https://staging-admin.sp3digital.com
